# Production frontend — builds the Vite app and outputs to /app/dist
FROM node:20-alpine AS builder

WORKDIR /app
COPY package.json ./
RUN npm install

COPY src/    ./src/
COPY index.html ./
COPY vite.config.js ./

RUN npm run build

# The built files end up in /app/dist which is mounted as a named volume
# shared with Nginx (see docker-compose.prod.yml)
