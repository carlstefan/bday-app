# Runtime environment
NODE_ENV=development

# Auth mode: "local" (dev/LAN) or "google" (production only)
AUTH_MODE=local

# Session secret — use a long random string in production
SESSION_SECRET=changeme_use_a_long_random_string_here

# Admin email addresses (comma-separated) — used to grant is_admin on Google OAuth login
ADMIN_EMAILS=

# Google OAuth 2.0 — only needed when AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# Backend server
PORT=3001
DB_PATH=/app/data/db.sqlite
UPLOADS_PATH=/app/uploads
